# ── ChronicleAgent 环境变量 ───────────────────────────
# 复制为 .env 并修改里面的值

# 应用
DEBUG=false                          # 生产环境关闭 debug
SECRET_KEY=change-this-to-random-key # 用于 session/CSRF 等

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=chronicle
DB_PASSWORD=chronicle_secret         # 修改为强密码
DB_NAME=chronicle

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# 向量存储（qdrant 或 pgvector）
VECTOR_STORE=qdrant

# LLM（至少填一个）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-real-key      # <-- 必填
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...

# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# QQ Bot 配置
BOT_QQ=123456789                   # Bot 自身 QQ 号
KP_QQ=987654321                    # KP（你）的 QQ 号
NA