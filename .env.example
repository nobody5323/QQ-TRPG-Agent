# ── ChronicleAgent 环境变量 ───────────────────────────
# 复制为 .env 并修改里面的值

# 应用
DEBUG=false                          # 生产环境关闭 debug
SECRET_KEY=change-this-to-random-key # 用于 session/CSRF 等

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=chronicle
DB_PASSWORD=chronicle_secret         # 修改为强密码
DB_NAME=chronicle

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# 向量存储（qdrant 或 pgvector）
VECTOR_STORE=qdrant

# LLM（聊天/分类/建议生成，至少填一个）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-real-key      # <-- 必填
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...

# Embedding（向量化，可独立于 LLM 配置）
# 留空则复用上面 LLM 对应的配置
# 如果用 DeepSeek 类的非 embedding API，必须填以下三项
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-embedding-key  # 如有独立 embedding key 则填写
EMBEDDING_BASE_URL=                      # 如 https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small   # 如 BAAI/bge-large-zh-v1.5（硅基流动）

# QQ Bot 配置
BOT_QQ=123456789                   # Bot 自身 QQ 号
NAPCAT_WS_URL=ws://napcat:8080     # NapCatQQ WebSocket 地址
# KP QQ 不需要配置——用户私聊 Bot 后使用 /绑定团 命令绑定到跑团项目
# 绑定数据持久化存储在 PostgreSQL 的 campaigns.kp_qq 字段中
